{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimoire",
  "version": "1.3.0",
  "identifier": "app.grimoire.notes",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Grimoire", "width": 1280, "height": 820, "minWidth": 380, "minHeight": 560, "backgroundColor": "#08080a" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
